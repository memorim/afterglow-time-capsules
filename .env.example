# Локальный порт. HOST допускает только localhost, 127.0.0.1 или ::1.
PORT=4800
HOST=127.0.0.1

# Hosted mode uses HTTP Basic with separately provisioned per-account databases.
# APP_PUBLIC_ORIGIN=https://capsules.example.com
# APP_ACCOUNTS={"owner":"replace-with-64-character-sha256-hex-digest"}
CAPSULE_RETENTION_DAYS=365
# Run scripts/maintenance-cycle.mjs from your operator scheduler to clean idle accounts too.
