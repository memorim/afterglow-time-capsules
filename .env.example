# Локальный порт. HOST допускает только localhost, 127.0.0.1 или ::1.
PORT=4800
HOST=127.0.0.1

# Hosted mode uses HTTP Basic with separately provisioned per-account databases.
# APP_PUBLIC_ORIGIN=https://capsules.example.com
# APP_ACCOUNTS={"owner":"replace-with-64-character-sha256-hex-digest"}
# Optional self-service registrations at /register.html. Keep this secret with your backups.
# AFTERGLOW_SIGNUP_SECRET=
# Optional expiry after opening. Zero keeps capsules until operator deletion.
CAPSULE_RETENTION_DAYS=0
# Run scripts/maintenance-cycle.mjs from your operator scheduler to clean idle accounts too.

# Persistent mount point for all application databases.
# AFTERGLOW_DATA_DIRECTORY=/var/lib/afterglow

# Optional HTTP budgets per database. Zero disables the configured budget.
# AFTERGLOW_CREATE_PER_MINUTE=10
# AFTERGLOW_OPEN_PER_MINUTE=30
# Enable only if an existing API client sends plaintext over its trusted connection.
# AFTERGLOW_ALLOW_LEGACY_CREATION=1
